            <mxGeometry x="60" y="420" width="420" height="106" as="geometry" />
          </mxCell>
        </object>
        <object id="upload-chunk-n30" label="3. Same index + same bytes bersifat idempotent, tetapi bukan kemajuan baru." source_files="app/Services/Attachment/AttachmentUploadService.php&#10;app/Http/Controllers/Nscmf/AttachmentUploadController.php&#10;app/Infrastructure/Storage/LocalPrivateStorage.php&#10;app/Repositories/Eloquent/Attachment/EloquentAttachmentRepository.php">
          <mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243548;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=15;rounded=0;dashed=1;fillColor=#FAFBFC;strokeColor=#B7C2CC;fontColor=#475569;fontSize=14;align=left;" vertex="1" parent="1">
            <mxGeometry x="60" y="556" width="420" height="100" as="geometry" />
          </mxCell>
        </object>
        <object id="upload-chunk-n31" label="4. Polling, duplicate, dan Complete tidak memperpanjang inactivity retention." source_files="app/Services/Attachment/AttachmentUploadService.php&#10;app/Http/Controllers/Nscmf/AttachmentUploadController.php&#10;app/Infrastructure/Storage/LocalPrivateStorage.php&#10;app/Repositories/Eloquent/Attachment/EloquentAttachmentRepository.php">
