            <mxGeometry x="60" y="2585" width="1980" height="100" as="geometry" />
          </mxCell>
        </object>
        <object id="approval-n40" label="5. Approved By adalah manusia. Tanda tangan kriptografis dibuat kemudian saat ekspor PDF APPROVED." source_files="app/Http/Controllers/Approval/ApprovalQueueController.php&#10;app/Http/Controllers/Approval/ApprovalDetailController.php&#10;app/Http/Controllers/Nscmf/Workflow/ApprovalActionController.php&#10;app/Services/Nscmf/NscmfWorkflowService.php&#10;resources/js/features/nscmf/workflow/approvalActions.ts&#10;resources/js/features/nscmf/workflow/RecordActions.vue">
