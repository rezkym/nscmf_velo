            <mxGeometry x="60" y="686" width="420" height="100" as="geometry" />
          </mxCell>
        </object>
        <object id="upload-chunk-n32" label="5. Chunk transport 5 MiB berbeda dari ukuran kirim internal ClamAV 64 KiB." source_files="app/Services/Attachment/AttachmentUploadService.php&#10;app/Http/Controllers/Nscmf/AttachmentUploadController.php&#10;app/Infrastructure/Storage/LocalPrivateStorage.php&#10;app/Repositories/Eloquent/Attachment/EloquentAttachmentRepository.php">
