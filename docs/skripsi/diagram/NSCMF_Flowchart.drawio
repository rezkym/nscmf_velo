            <mxGeometry x="60" y="290" width="420" height="100" as="geometry" />
          </mxCell>
        </object>
        <object id="upload-chunk-n29" label="2. Write bytes dilakukan sebelum metadata. Jika metadata ditolak / race kalah, bytes yang tidak diakui dibersihkan." source_files="app/Services/Attachment/AttachmentUploadService.php&#10;app/Http/Controllers/Nscmf/AttachmentUploadController.php&#10;app/Infrastructure/Storage/LocalPrivateStorage.php&#10;app/Repositories/Eloquent/Attachment/EloquentAttachmentRepository.php">
