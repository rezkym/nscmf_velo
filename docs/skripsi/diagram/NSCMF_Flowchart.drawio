        <object id="approval-n36" label="1. Kotak keputusan menunjukkan alternatif. Approve tidak menjalankan Return/Reject berikutnya." source_files="app/Http/Controllers/Approval/ApprovalQueueController.php&#10;app/Http/Controllers/Approval/ApprovalDetailController.php&#10;app/Http/Controllers/Nscmf/Workflow/ApprovalActionController.php&#10;app/Services/Nscmf/NscmfWorkflowService.php&#10;resources/js/features/nscmf/workflow/approvalActions.ts&#10;resources/js/features/nscmf/workflow/RecordActions.vue">
          <mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243548;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=15;rounded=0;dashed=1;fillColor=#FAFBFC;strokeColor=#B7C2CC;fontColor=#475569;fontSize=14;align=left;" vertex="1" parent="1">
            <mxGeometry x="60" y="2195" width="1980" height="100" as="geometry" />
          </mxCell>
        </object>
        <object id="approval-n37" label="2. Approve memakai nscmf.approve; tiga tindakan lainnya punya izin approval tersendiri." source_files="app/Http/Controllers/Approval/ApprovalQueueController.php&#10;app/Http/Controllers/Approval/ApprovalDetailController.php&#10;app/Http/Controllers/Nscmf/Workflow/ApprovalActionController.php&#10;app/Services/Nscmf/NscmfWorkflowService.php&#10;resources/js/features/nscmf/workflow/approvalActions.ts&#10;resources/js/features/nscmf/workflow/RecordActions.vue">
          <mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243548;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=15;rounded=0;dashed=1;fillColor=#FAFBFC;strokeColor=#B7C2CC;fontColor=#475569;fontSize=14;align=left;" vertex="1" parent="1">
            <mxGeometry x="60" y="2325" width="1980" height="100" as="geometry" />
          </mxCell>
        </object>
        <object id="approval-n38" label="3. Return tetap pada iteration yang sama; riwayat Review lama tetap ada di Audit." source_files="app/Http/Controllers/Approval/ApprovalQueueController.php&#10;app/Http/Controllers/Approval/ApprovalDetailController.php&#10;app/Http/Controllers/Nscmf/Workflow/ApprovalActionController.php&#10;app/Services/Nscmf/NscmfWorkflowService.php&#10;resources/js/features/nscmf/workflow/approvalActions.ts&#10;resources/js/features/nscmf/workflow/RecordActions.vue">
          <mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=#243548;strokeWidth=1.6;align=center;verticalAlign=middle;spacing=15;rounded=0;dashed=1;fillColor=#FAFBFC;strokeColor=#B7C2CC;fontColor=#475569;fontSize=14;align=left;" vertex="1" parent="1">
            <mxGeometry x="60" y="2455" width="1980" height="100" as="geometry" />
          </mxCell>
        </object>
        <object id="approval-n39" label="4. Pengguna dengan gabungan izin boleh melakukan Review dan Approval; tidak ada pemisahan pelaku wajib." source_files="app/Http/Controllers/Approval/ApprovalQueueController.php&#10;app/Http/Controllers/Approval/ApprovalDetailController.php&#10;app/Http/Controllers/Nscmf/Workflow/ApprovalActionController.php&#10;app/Services/Nscmf/NscmfWorkflowService.php&#10;resources/js/features/nscmf/workflow/approvalActions.ts&#10;resources/js/features/nscmf/workflow/RecordActions.vue">
