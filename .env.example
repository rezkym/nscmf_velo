APP_NAME="NSCMF"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4 only. Local development uses the compose.yaml MySQL service.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nscmf
DB_USERNAME=nscmf
DB_PASSWORD=

# Session idle lifetime (30 minutes) is locked in config/session.php, not configurable here.
SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Private storage roots. Leave empty to use storage/app/private/nscmf and
# storage/app/private/nscmf-runtime-tmp. Production roots must be persistent.
NSCMF_PRIVATE_STORAGE_ROOT=
NSCMF_RUNTIME_TMP_ROOT=

# ClamAV (Phase 6): choose unix or tcp. Endpoint must stay private.
NSCMF_CLAMAV_TRANSPORT=tcp
NSCMF_CLAMAV_SOCKET=
NSCMF_CLAMAV_HOST=127.0.0.1
NSCMF_CLAMAV_PORT=3310
NSCMF_CLAMAV_TIMEOUT_SECONDS=30

# PROVISIONAL rate limits (gap G05), requests per minute.
UPLOAD_RATE_PER_MINUTE=120
UPLOAD_FINALIZE_PER_MINUTE=20
PDF_VALIDATOR_RATE_PER_MINUTE=10

# Spreadsheet renderer (Phase 8): LibreOffice Headless is the first candidate, not yet qualified.
NSCMF_RENDERER_DRIVER=
NSCMF_RENDERER_EXECUTABLE=
NSCMF_RENDERER_ENDPOINT=
NSCMF_RENDERER_TIMEOUT_SECONDS=

VITE_APP_NAME="${APP_NAME}"
